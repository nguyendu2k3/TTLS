<div class="featured-section my-4">
    <div class="container">
        <div class="bg-white rounded p-4">
            <div class="featured-section-group">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="h2 mb-2">Liên Hệ</h5>
                        <form action="#" id="contact_form" method="post">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group required-field">
                                        <label for="contact-name">Họ và tên người gửi (*): </label>
                                        <input type="text" class="form-control" id="contact-name" name="contact-name" required>
                                    </div><!-- End .form-group -->
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="contact-phone">Điện thoại (*): </label>
                                        <input type="tel" class="form-control" id="contact-phone" name="contact-phone" required>
                                    </div><!-- End .form-group -->
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="contact-phone">Địa chỉ</label>
                                        <input type="text" class="form-control" id="contact-address" name="contact-address">
                                    </div><!-- End .form-group -->
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group required-field">
                                        <label for="contact-email">Email (*): </label>
                                        <input type="email" class="form-control" id="contact-email" name="contact-email" required>
                                    </div><!-- End .form-group -->
                                </div>

                            </div>


                            <div class="form-group required-field">
                                <label for="contact-message">Nội dung (*): </label>
                                <textarea cols="30" rows="1" id="contact-message" class="form-control" name="contact-message" required></textarea>
                            </div><!-- End .form-group -->

                            <div class="form-footer">
                                <button type="submit" class="btn btn-primary rounded"><i class="fa-regular fa-paper-plane"></i> Gửi</button>
                            </div><!-- End .form-footer -->
                        </form>
                    </div>
                    <div class="col-md-6">
                        <div id="map">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d40766.42070098997!2d105.75579037093927!3d9.983693223517577!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31a089844afc2a33%3A0x4b948daff0ec9874!2zTmdoxKlhIHRyYW5nIExp4buHdCBzxKkgVGjDoG5oIHBo4buRIEPhuqduIFRoxqE!5e0!3m2!1svi!2s!4v1681895375766!5m2!1svi!2s" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    </div>
                </div><!-- End .row -->
            </div>
        </div>
    </div>
</div>
