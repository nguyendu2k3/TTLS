@model ThongTinLietSi.Models.TinTucDetailViewModel
<nav aria-label="breadcrumb" class="breadcrumb-nav">
	<div class="container">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
			<li class="breadcrumb-item">
				<a href="/Home/TinTuc">Tin tức - Hoạt động</a>
			</li>
			<li class="breadcrumb-item active" aria-current="page">@Model.TinTuc.Title</li>
		</ol>
	</div>


<div class="featured-section my-4">
	<div class="container">
		<div class="row">
			<div class="col-lg-9">
				<div class="blog-page">
					<article class="entry single">
						<div class="entry-body">

							<h1 class="entry-title">
									@Model.TinTuc.Title
							</h1>
							<div class="entry-meta pt-3 pt-md-0">
								<span><i class="fa-solid fa-user-large"></i>Đăng bởi: admin</span>
								<span><i class="fa-regular fa-calendar-days"></i> 06/09/2024</span>
								<span><i class="fa-regular fa-eye"></i>Lượt xem: 72</span>
							</div><!-- End .entry-meta -->

							<div class="entry-content mt-2 mt-md-3 mb-2">
									<div style="text-align:center"><img alt="" height="1165" src="~/images/@Model.TinTuc.img" width="1970" /></div>
								<p style="text-align:justify">
									<span style="font-size:14pt">
										<span style="font-family:'Times New Roman',serif;">
											@Html.Raw(Model.TinTuc.Content)
										</span>
									</span>
								</p>
							</div><!-- End .entry-content -->
							<div class="sharethis-inline-share-buttons"></div>
						</div><!-- End .entry-body -->
					</article><!-- End .entry -->

				</div>
			</div>
			<aside class="sidebar-shop col-lg-3">
				<div class="sidebar-wrapper">
					<div class="widget">
						<h4 class="widget-title">
							<a data-toggle="collapse" href="#widget-body-5" role="button" aria-expanded="true" aria-controls="widget-body-5" class="">Chuyên mục</a>
						</h4>
						<div class="collapse show" id="widget-body-5" style="">
							<div class="widget-body">
								<ul class="list">
									<li><a href="/gioi-thieu">Giới thiệu</a></li>
									<li><a href="/tin-tuc-hoat-dong">Tin tức - Hoạt động</a></li>
									<li><a href="/su-kien">Chuyên mục chuyển đổi số</a></li>
								</ul>
							</div><!-- End .widget-body -->
						</div><!-- End .collapse -->

					</div>
						<div class="widget">
							<h4 class="widget-title">
								<a data-toggle="collapse" href="#widget-body-7" role="button" aria-expanded="true" aria-controls="widget-body-7">Tin liên quan</a>
							</h4>
							<div class="collapse show" id="widget-body-7">
								<div class="widget-body pl-0">
									<ul class="simple-entry-list">
										@foreach (var relatedArticle in Model.RelatedArticles)
										{
											<li>
												<div class="entry-media">
													<a href="@Url.Action("TinTucDetail", "Home", new { id = relatedArticle.Id })">
														<img src="~/images/@relatedArticle.img" alt="@relatedArticle.Title" />
													</a>
												</div>
												<div class="entry-info">
													<a href="@Url.Action("TinTucDetail", "Home", new { id = relatedArticle.Id })" title="@relatedArticle.Title">@relatedArticle.Title</a>
												</div>
											</li>
										}
									</ul>
								</div>
							</div>
						</div>

				</div><!-- End .sidebar-wrapper -->
			</aside><!-- End .col-lg-3 -->
		</div>
	</div><!-- End .container -->
</div>